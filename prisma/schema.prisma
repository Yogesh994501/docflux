// AutoFinDocs — Intelligent Document OCR & Parsing Platform
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users (local auth — used when Supabase is NOT configured) ────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents       Document[]
  vendors         Vendor[]
  copilotMessages CopilotMessage[]
}

// ─── Documents (scoped to a user) ─────────────────────────────────────────────

model Document {
  id             String   @id @default(cuid())
  fileName       String
  fileType       String
  fileSize       Int
  storagePath    String
  thumbnailPath  String?

  documentType   String?
  source         String   @default("web")
  status         String   @default("UPLOADED")

  ocrText        String?
  ocrConfidence  Float?
  ocrLanguage    String?  @default("en")
  extractedData  String?

  fraudRisk      String?
  approvalComments String?
  approvedBy     String?

  vendorId       String?
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])

  // Owner of this document
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  uploadedAt     DateTime @default(now())
  processedAt    DateTime?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  auditLogs      AuditLog[]

  @@index([status])
  @@index([documentType])
  @@index([vendorId])
  @@index([userId])
  @@index([uploadedAt])
}

// ─── Vendors / Customers (scoped to a user) ───────────────────────────────────

model Vendor {
  id          String   @id @default(cuid())
  name        String
  gstin       String?
  pan         String?
  email       String?
  phone       String?
  address     String?
  category    String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents   Document[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([userId])
}

// ─── Audit Trail ──────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  action      String
  details     String?
  actor       String?  @default("system")
  timestamp   DateTime @default(now())

  @@index([documentId])
  @@index([action])
}

// ─── AI Copilot Conversations (scoped to a user) ──────────────────────────────

model CopilotMessage {
  id          String   @id @default(cuid())
  role        String
  content     String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
