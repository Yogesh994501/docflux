# ═══════════════════════════════════════════════════════════════════════════
# AutoFinDocs — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────────────────────────
# SQLite (default — used when Supabase is NOT configured)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# ─── Supabase (optional — set BOTH to switch from SQLite → Supabase) ────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── OCR Provider ───────────────────────────────────────────────────────────
# "gemini" → Google Gemini 2.5 Flash (requires GEMINI_API_KEY)
# "zai"    → Z.ai GLM-4.6V vision (default)
OCR_PROVIDER="gemini"

# ─── Google Gemini (for OCR) ────────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ─── Auth bypass (for testing) ──────────────────────────────────────────────
# Set to "true" to disable login/signup and auto-use a default test user.
# All auth code stays intact — flip to "false" (or remove) to re-enable auth.
AUTH_DISABLED="true"

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV="development"
